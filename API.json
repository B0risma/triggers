// CV Control Target
{
  "id": "tgt_001",
  "type": "cv",
  "name": "Smoke Machine Control",
  "config": {
    "modules": [
      {
        "name": "fire",
        "channel": 1,
        "active_on_signal": true,
        "fade_ms": 0
      },
      {
        "name": "smoke",
        "channel": 2,
        "active_on_signal": true,
        "fade_ms": 500
      },
      {
        "name": "haze",
        "channel": 3,
        "active_on_signal": false,
        "fade_ms": 0
      }
    ],
    "bus_type": "dmx",  // "dmx", "artnet", "gpio", "midi"
    "universe": 0,
    "refresh_rate_hz": 30
  },
  "constraints": {
    "requires_ack": false,
    "max_rate_per_second": 10
  },
  "metadata": {
    "created_at": "2026-01-15T10:30:00Z",
    "updated_at": "2026-01-15T10:30:00Z"
  }
}

