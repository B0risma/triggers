GET    /api/triggers              # List all triggers
POST   /api/triggers              # Create new trigger
GET    /api/triggers/{id}         # Get trigger details
PUT    /api/triggers/{id}         # Update trigger
DELETE /api/triggers/{id}         # Delete trigger

GET    /api/targets               # List all targets
POST   /api/targets               # Create new target
GET    /api/targets/{id}          # Get target details
PUT    /api/targets/{id}          # Update target
DELETE /api/targets/{id}          # Delete target

GET    /api/reactions             # List all reaction rules
POST   /api/reactions             # Create reaction (bind trigger+target)
PUT    /api/reactions/{id}        # Update reaction
DELETE /api/reactions/{id}        # Delete reaction

POST   /api/system/trigger/{id}   # Manual trigger (testing)
GET    /api/system/status         # Get current system status

