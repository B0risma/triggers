// Switch Trigger (Virtual or GPIO)
{
  "id": "trg_002",
  "type": "switch",
  "name": "Emergency Stop Button",
  "enabled": true,
  "config": {
    "input_type": "gpio",  // "gpio" or "virtual"
    "pin": "GPIO_17",
    "pull": "up",          // "up", "down", "none"
    "debounce_ms": 50,
    "active_state": "low"  // "high" or "low"
  },
  "metadata": {
    "created_at": "2026-01-15T10:30:00Z",
    "updated_at": "2026-01-15T10:30:00Z",
    "created_by": "admin"
  }
}

// SingleShot Trigger
{
  "id": "trg_003",
  "type": "singleshot",
  "name": "Door Open Alert",
  "enabled": true,
  "config": {
    "source_pin": "GPIO_23",
    "trigger_on": "rising_edge",  // "rising_edge", "falling_edge", "both"
    "debounce_ms": 100,
    "auto_disable_after_ms": 5000,  // Auto re-arm after 5 seconds
    "max_triggers_per_minute": 10
  },
  "metadata": {
    "created_at": "2026-01-15T10:30:00Z",
    "updated_at": "2026-01-15T10:30:00Z",
    "created_by": "admin"
  }
}

